# Discord
DISCORD_TOKEN=your_bot_token_here
# Enable Server Members Intent: Discord Developer Portal → Your App → Bot → Privileged Gateway Intents

# Rocket League API (Epic Games OAuth)
RLAPI_CLIENT_ID=your_epic_client_id
RLAPI_CLIENT_SECRET=your_epic_client_secret

# Database (optional, defaults to SQLite)
# DATABASE_URL=sqlite+aiosqlite:///./octane.db

# Role IDs or names (comma-separated). Names are case-insensitive.
# MODERATOR_ROLE_IDS=123456789,987654321
# MODERATOR_ROLE_NAMES=Tournament Commissioner,Moderator
# Note: Use correct spelling (e.g. "Commissioner" not "Comissioner")
# ADMIN_ROLE_IDS=111222333
# ADMIN_ROLE_NAMES=Admin

# User IDs (bypass when Members Intent fails to return roles)
# MODERATOR_USER_IDS=123456789
# ADMIN_USER_IDS=123456789

# Web → Bot internal API (for posting signup from web UI)
# BOT_INTERNAL_URL=http://bot:8001
# INTERNAL_API_SECRET=shared-secret-between-web-and-bot

# Public site URL (for Discord embeds — link to /current in tournament post)
# SITE_URL=https://tournaments.example.com

# Web auth (JWT + initial admin bootstrap)
# JWT_SECRET=your-long-random-secret-change-in-production
# Set INITIAL_ADMIN_USERNAME and INITIAL_ADMIN_PASSWORD to create the first global admin on first login.
# After that, global admins can create users in Settings → User management.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=your-secure-password

# Global admins: site-wide admin (user management, global settings). Comma-separated usernames.
# Discord guild admins get guild-level admin only; add usernames here for site-wide access.
# GLOBAL_ADMIN_USERNAMES=admin,siteowner
